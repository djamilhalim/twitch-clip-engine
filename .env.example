# ── Twitch (https://dev.twitch.tv/console/apps → "Register Your Application") ──
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Nur nötig für Live-Hype-Clips (clips:edit) und offiziellen Download als Editor
# (editor:manage:clips). Wird mit `python -m engine auth-twitch` erzeugt.
TWITCH_USER_REFRESH_TOKEN=

# ── Buffer (https://publish.buffer.com/settings/api) ──
BUFFER_API_KEY=
# Kanal-IDs mit `python -m engine buffer-kanaele` anzeigen lassen
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_YOUTUBE_CHANNEL_ID=

# ── Supabase Storage (öffentliche Video-URL für Buffer) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# ── Optional: eigene TikTok-App (https://developers.tiktok.com) ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://deine-domain.de/tiktok-callback
TIKTOK_REFRESH_TOKEN=

# ── Optional: eigenes Google-Projekt für YouTube-Upload ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Optional: Benachrichtigung bei Fehlern / neuen Clips in der Freigabe ──
# Discord-Webhook-URL (kostenlos)
NOTIFY_DISCORD_WEBHOOK=
